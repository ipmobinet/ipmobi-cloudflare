{
  "name": "@ipmobi/worker",
  "version": "1.0.0",
  "private": true,
  "description": "IPMOBI API — Cloudflare Worker (Hono)",
  "scripts": {
    "db:init": "wrangler d1 execute ipmobi-db --file=src/db/schema.sql",
    "db:migrate": "wrangler d1 migrations apply ipmobi-db --remote",
    "dev": "wrangler dev src/index.ts --port 8787 --remote",
    "deploy:worker": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "typescript": "^5.7.0",
    "@cloudflare/workers-types": "^4.20250501.0"
  }
}
